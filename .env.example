# ============== LLM 配置 ==============
# 通义千问（DashScope）兼容 OpenAI 接口的密钥，去阿里云 DashScope 控制台申请
LLM_API_KEY=your-dashscope-api-key
LLM_MODEL_NAME=qwen3.6-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============== LangSmith 配置（可选，用于链路追踪）==============
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=zhixing-travel-planner-dev
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============== 数据库配置 ==============
# PostgreSQL（用于 Checkpointer 和 Store），本地 Docker 容器
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_planner_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=your-postgres-password
# 注意：连接串由 app/config.py 用上面的 POSTGRES_* 变量自动拼出，不要单独配 DATABASE_URL

# Redis（用于缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============== MCP 服务配置 ==============
# 高德 API（天气和地图）
AMAP_API_KEY=your-amap-api-key

# Tavily 搜索 API
TAVILY_API_KEY=your-tavily-api-key

# Variflight 航班 API
VARIFLIGHT_API_KEY=your-variflight-api-key

# AIGOHOTEL 酒店 MCP API
AIGOHOTEL_MCP_API=your-aigohotel-mcp-api

# ============== 应用配置 ==============
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ============== 安全配置 ==============
# JWT 签名密钥，必须独立配置（不要用 LLM 密钥代替）
# 生成方式：uv run python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 允许跨域访问前端页面的来源，逗号分隔；上线后改成自己的域名
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 正则白名单，默认放行本机任意端口和 file:// 直接打开（Origin 为 null）
# 上线后改成 ^https://你的域名$，或者留空彻底关闭
CORS_ALLOW_ORIGIN_REGEX=^(http://(localhost|127\.0\.0\.1)(:\d+)?|null)$

# 单次回复最大 token 数；公开部署时调低可以压低被刷时的花费上限
LLM_MAX_TOKENS=4000
